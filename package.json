{
  "name": "health-in-check",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "NODE_OPTIONS=--max-old-space-size=256 PORT=3000 tsx scripts/start-local-api.ts",
    "dev:api": "tsx scripts/start-local-api.ts",
    "dev": "concurrently \"npm run dev:api\" \"vite\"",
    "build": "NODE_OPTIONS=--max-old-space-size=512 vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--max-old-space-size=512 vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@supabase/supabase-js": "latest",
    "dompurify": "^3.2.4",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsdom": "^28.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
